#################################################################
#    Object Properties
#################################################################

###  http://www.semanticweb.org/luan/ontologies/2026/8/untitled-ontology-6#ministra
untitled-ontology-6:ministra rdf:type owl:ObjectProperty ;
                             rdfs:domain untitled-ontology-6:Professor ;
                             rdfs:range untitled-ontology-6:Disciplina .


###  http://www.semanticweb.org/luan/ontologies/2026/8/untitled-ontology-6#ministraEm
untitled-ontology-6:ministraEm rdf:type owl:ObjectProperty ;
                               rdfs:domain untitled-ontology-6:Aula ;
                               rdfs:range untitled-ontology-6:Sala .


###  http://www.semanticweb.org/luan/ontologies/2026/8/untitled-ontology-6#ministraTurma
untitled-ontology-6:ministraTurma rdf:type owl:ObjectProperty ;
                                  owl:inverseOf untitled-ontology-6:ministradaPor ;
                                  rdfs:domain untitled-ontology-6:Professor ;
                                  rdfs:range untitled-ontology-6:Turma .


###  http://www.semanticweb.org/luan/ontologies/2026/8/untitled-ontology-6#ministradaPor
untitled-ontology-6:ministradaPor rdf:type owl:ObjectProperty ;
                                  rdfs:domain untitled-ontology-6:Aula ;
                                  rdfs:range untitled-ontology-6:Professor .


###  http://www.semanticweb.org/luan/ontologies/2026/8/untitled-ontology-6#ocorreEmHorario
untitled-ontology-6:ocorreEmHorario rdf:type owl:ObjectProperty ;
                                    rdfs:domain untitled-ontology-6:Aula ;
                                    rdfs:range untitled-ontology-6:Horario .


###  http://www.semanticweb.org/luan/ontologies/2026/8/untitled-ontology-6#ocorreNoDia
untitled-ontology-6:ocorreNoDia rdf:type owl:ObjectProperty ;
                                rdfs:domain untitled-ontology-6:Aula ;
                                rdfs:range untitled-ontology-6:Dia .


###  http://www.semanticweb.org/luan/ontologies/2026/8/untitled-ontology-6#ofereceDisciplina
untitled-ontology-6:ofereceDisciplina rdf:type owl:ObjectProperty ;
                                      rdfs:domain untitled-ontology-6:Turma ;
                                      rdfs:range untitled-ontology-6:Disciplina .


###  http://www.semanticweb.org/luan/ontologies/2026/8/untitled-ontology-6#ofereceTurma
untitled-ontology-6:ofereceTurma rdf:type owl:ObjectProperty ;
                                 rdfs:subPropertyOf owl:topObjectProperty ;
                                 rdfs:domain untitled-ontology-6:Curso ;
                                 rdfs:range untitled-ontology-6:Turma .


###  http://www.semanticweb.org/luan/ontologies/2026/8/untitled-ontology-6#pertenceATurma
untitled-ontology-6:pertenceATurma rdf:type owl:ObjectProperty ;
                                   rdfs:domain untitled-ontology-6:Aula ;
                                   rdfs:range untitled-ontology-6:Turma .


###  http://www.semanticweb.org/luan/ontologies/2026/8/untitled-ontology-6#pertenceAo
untitled-ontology-6:pertenceAo rdf:type owl:ObjectProperty ;
                               rdfs:domain untitled-ontology-6:Horario ;
                               rdfs:range untitled-ontology-6:Turno .


###  http://www.semanticweb.org/luan/ontologies/2026/8/untitled-ontology-6#pertencePeriodo
untitled-ontology-6:pertencePeriodo rdf:type owl:ObjectProperty ;
                                    rdfs:domain untitled-ontology-6:Turma ;
                                    rdfs:range untitled-ontology-6:Periodo .


###  http://www.semanticweb.org/luan/ontologies/2026/8/untitled-ontology-6#possuiSala
untitled-ontology-6:possuiSala rdf:type owl:ObjectProperty ;
                               rdfs:subPropertyOf owl:topObjectProperty ;
                               rdfs:domain untitled-ontology-6:Curso ;
                               rdfs:range untitled-ontology-6:Sala .


###  http://www.semanticweb.org/luan/ontologies/2026/8/untitled-ontology-6#temDisciplina
untitled-ontology-6:temDisciplina rdf:type owl:ObjectProperty ;
                                  rdfs:domain untitled-ontology-6:Aula ;
                                  rdfs:range untitled-ontology-6:Disciplina .


#################################################################
#    Data properties
#################################################################

###  http://www.semanticweb.org/luan/ontologies/2026/8/untitled-ontology-6#diaSemana
untitled-ontology-6:diaSemana rdf:type owl:DatatypeProperty ;
                              rdfs:subPropertyOf owl:topDataProperty ;
                              rdfs:domain untitled-ontology-6:Dia ;
                              rdfs:range xsd:string .


###  http://www.semanticweb.org/luan/ontologies/2026/8/untitled-ontology-6#horaFim
untitled-ontology-6:horaFim rdf:type owl:DatatypeProperty ;
                            rdfs:domain untitled-ontology-6:Horario ;
                            rdfs:range xsd:string .


###  http://www.semanticweb.org/luan/ontologies/2026/8/untitled-ontology-6#horaInicio
untitled-ontology-6:horaInicio rdf:type owl:DatatypeProperty ;
                               rdfs:domain untitled-ontology-6:Horario ;
                               rdfs:range xsd:string .


###  http://www.semanticweb.org/luan/ontologies/2026/8/untitled-ontology-6#nomeDisciplina
untitled-ontology-6:nomeDisciplina rdf:type owl:DatatypeProperty ;
                                   rdfs:domain untitled-ontology-6:Disciplina ;
                                   rdfs:range xsd:string .


###  http://www.semanticweb.org/luan/ontologies/2026/8/untitled-ontology-6#nomeProfessor
untitled-ontology-6:nomeProfessor rdf:type owl:DatatypeProperty ;
                                  rdfs:domain untitled-ontology-6:Professor ;
                                  rdfs:range xsd:string .


###  http://www.semanticweb.org/luan/ontologies/2026/8/untitled-ontology-6#nomeSala
untitled-ontology-6:nomeSala rdf:type owl:DatatypeProperty ;
                             rdfs:domain untitled-ontology-6:Sala ;
                             rdfs:range xsd:string .


###  http://www.semanticweb.org/luan/ontologies/2026/8/untitled-ontology-6#nomeTurno
untitled-ontology-6:nomeTurno rdf:type owl:DatatypeProperty ;
                              rdfs:subPropertyOf owl:topDataProperty ;
                              rdfs:domain untitled-ontology-6:Turno ;
                              rdfs:range xsd:string .


###  http://www.semanticweb.org/luan/ontologies/2026/8/untitled-ontology-6#temCargaHoraria
untitled-ontology-6:temCargaHoraria rdf:type owl:DatatypeProperty ;
                                    rdfs:domain untitled-ontology-6:Disciplina ;
                                    rdfs:range [ rdf:type rdfs:Datatype ;
                                                 owl:oneOf [ rdf:type rdf:List ;
                                                             rdf:first 108 ;
                                                             rdf:rest [ rdf:type rdf:List ;
                                                                        rdf:first 54 ;
                                                                        rdf:rest [ rdf:type rdf:List ;
                                                                                   rdf:first 81 ;
                                                                                   rdf:rest rdf:nil
                                                                                 ]
                                                                      ]
                                                           ]
                                               ] .


#################################################################
#    Classes
#################################################################

###  http://www.semanticweb.org/luan/ontologies/2026/8/untitled-ontology-6#Aula
untitled-ontology-6:Aula rdf:type owl:Class .


###  http://www.semanticweb.org/luan/ontologies/2026/8/untitled-ontology-6#Curso
untitled-ontology-6:Curso rdf:type owl:Class ;
                          rdfs:label "Curso"@pt-br .


###  http://www.semanticweb.org/luan/ontologies/2026/8/untitled-ontology-6#Dia
untitled-ontology-6:Dia rdf:type owl:Class .


###  http://www.semanticweb.org/luan/ontologies/2026/8/untitled-ontology-6#Disciplina
untitled-ontology-6:Disciplina rdf:type owl:Class .


###  http://www.semanticweb.org/luan/ontologies/2026/8/untitled-ontology-6#DisciplinaLabRedes
untitled-ontology-6:DisciplinaLabRedes rdf:type owl:Class ;
                                       rdfs:subClassOf untitled-ontology-6:Disciplina ,
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty untitled-ontology-6:ministraEm ;
                                                         owl:hasValue untitled-ontology-6:labRedes
                                                       ] .


###  http://www.semanticweb.org/luan/ontologies/2026/8/untitled-ontology-6#DisciplinaProjInter
untitled-ontology-6:DisciplinaProjInter rdf:type owl:Class ;
                                        rdfs:subClassOf untitled-ontology-6:Disciplina ,
                                                        [ owl:intersectionOf ( [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                                                                        owl:onProperty untitled-ontology-6:ocorreEmHorario ;
                                                                                                        owl:hasValue untitled-ontology-6:HorarioBlocoI
                                                                                                      ]
                                                                                                      [ rdf:type owl:Restriction ;
                                                                                                        owl:onProperty untitled-ontology-6:ocorreEmHorario ;
                                                                                                        owl:hasValue untitled-ontology-6:HorarioBlocoII
                                                                                                      ]
                                                                                                      [ rdf:type owl:Restriction ;
                                                                                                        owl:onProperty untitled-ontology-6:ocorreEmHorario ;
                                                                                                        owl:hasValue untitled-ontology-6:HorarioBlocoIII
                                                                                                      ]
                                                                                                    ) ;
                                                                                 rdf:type owl:Class
                                                                               ]
                                                                               [ rdf:type owl:Restriction ;
                                                                                 owl:onProperty untitled-ontology-6:ocorreNoDia ;
                                                                                 owl:hasValue untitled-ontology-6:diaSab
                                                                               ]
                                                                             ) ;
                                                          rdf:type owl:Class
                                                        ] .


###  http://www.semanticweb.org/luan/ontologies/2026/8/untitled-ontology-6#DisciplinaTCC
untitled-ontology-6:DisciplinaTCC rdf:type owl:Class ;
                                  rdfs:subClassOf untitled-ontology-6:Disciplina ,
                                                  [ owl:intersectionOf ( [ rdf:type owl:Class ;
                                                                           owl:unionOf ( [ rdf:type owl:Restriction ;
                                                                                           owl:onProperty untitled-ontology-6:ocorreEmHorario ;
                                                                                           owl:hasValue untitled-ontology-6:HorarioBlocoManhaI
                                                                                         ]
                                                                                         [ rdf:type owl:Restriction ;
                                                                                           owl:onProperty untitled-ontology-6:ocorreEmHorario ;
                                                                                           owl:hasValue untitled-ontology-6:HorarioBlocoManhaII
                                                                                         ]
                                                                                         [ rdf:type owl:Restriction ;
                                                                                           owl:onProperty untitled-ontology-6:ocorreEmHorario ;
                                                                                           owl:hasValue untitled-ontology-6:HorarioBlocoNoiteI
                                                                                         ]
                                                                                         [ rdf:type owl:Restriction ;
                                                                                           owl:onProperty untitled-ontology-6:ocorreEmHorario ;
                                                                                           owl:hasValue untitled-ontology-6:HorarioBlocoNoiteII
                                                                                         ]
                                                                                       )
                                                                         ]
                                                                         [ rdf:type owl:Restriction ;
                                                                           owl:onProperty untitled-ontology-6:ocorreNoDia ;
                                                                           owl:hasValue untitled-ontology-6:diaSab
                                                                         ]
                                                                       ) ;
                                                    rdf:type owl:Class
                                                  ] .


###  http://www.semanticweb.org/luan/ontologies/2026/8/untitled-ontology-6#Horario
untitled-ontology-6:Horario rdf:type owl:Class .


###  http://www.semanticweb.org/luan/ontologies/2026/8/untitled-ontology-6#Periodo
untitled-ontology-6:Periodo rdf:type owl:Class .


###  http://www.semanticweb.org/luan/ontologies/2026/8/untitled-ontology-6#Professor
untitled-ontology-6:Professor rdf:type owl:Class .


###  http://www.semanticweb.org/luan/ontologies/2026/8/untitled-ontology-6#Sala
untitled-ontology-6:Sala rdf:type owl:Class .


###  http://www.semanticweb.org/luan/ontologies/2026/8/untitled-ontology-6#Turma
untitled-ontology-6:Turma rdf:type owl:Class .


###  http://www.semanticweb.org/luan/ontologies/2026/8/untitled-ontology-6#Turno
untitled-ontology-6:Turno rdf:type owl:Class .


