        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://www.semanticweb.org/luan/ontologies/2026/8/untitled-ontology-6#ocorreEmHorario"/>
                                <owl:hasValue rdf:resource="http://www.semanticweb.org/luan/ontologies/2026/8/untitled-ontology-6#HorarioBlocoI"/>
