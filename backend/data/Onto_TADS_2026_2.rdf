                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/luan/ontologies/2026/8/untitled-ontology-6#ocorreNoDia"/>
                        <owl:hasValue rdf:resource="http://www.semanticweb.org/luan/ontologies/2026/8/untitled-ontology-6#diaSab"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/luan/ontologies/2026/8/untitled-ontology-6#DisciplinaTCC -->

